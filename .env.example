# FinancialAR OSINT - Environment Variables Example
# Copia este archivo a .env y configura tus valores

# Flask Configuration
# Genera un SECRET_KEY aleatorio con: python3 -c "import os; print(os.urandom(24).hex())"
SECRET_KEY=your-random-secret-key-here-change-this
FLASK_DEBUG=False
FLASK_ENV=production

# BCRA API Configuration
BCRA_API_TIMEOUT=30
BCRA_API_RETRIES=3

# Application Configuration
APP_PORT=5050
APP_HOST=0.0.0.0

# Database Configuration
AFIP_DB_PATH=data/afip_monotributo.db

# Logging Configuration
LOG_LEVEL=INFO
